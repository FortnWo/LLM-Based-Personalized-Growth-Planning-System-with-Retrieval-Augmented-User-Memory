# Copy this file to .env and fill in your values

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="AI Mentor & Growth Planning System"
APP_VERSION="0.1.0"
DEBUG=false

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/ai_mentor_db
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173"]

# ── AI provider (OpenAI-compatible: Ark / Zhipu / etc.) ──────────────────────
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_MODEL=
RUN_LIVE_AI_TESTS=0

# Background AI task thread pool size
# AI_BACKGROUND_MAX_WORKERS=12

# Runtime priority:
#   LLM credentials (key / base URL / model): .env > admin panel DB > config.py default
#   LLM prompts (mentor / admin chat):          admin panel DB > .env > config.py default
# LLM_SYSTEM_PROMPT=
# ADMIN_LLM_SYSTEM_PROMPT=
# SESSION_TITLE_SYSTEM_PROMPT=

# ── Profile extraction ───────────────────────────────────────────────────────
# PROFILE_EXTRACTION_ENABLED=true
# PROFILE_EXTRACTION_MESSAGE_WINDOW=14
# PROFILE_EXTRACTION_MIN_INTERVAL_MINUTES=5
# PROFILE_EXTRACTION_BURST_USER_TURNS=3
# PROFILE_EXTRACTION_ON_DEMAND_ENABLED=true
# PROFILE_EXTRACTION_MIN_USER_MESSAGE_CHARS=12
# PROFILE_EXTRACTION_SYSTEM_PROMPT=
# PORTRAIT_SUMMARY_SYSTEM_PROMPT=

# ── Goal breakdown & action plans ────────────────────────────────────────────
GOAL_BREAKDOWN_ENABLED=true
# GOAL_BREAKDOWN_MESSAGE_WINDOW=5
# GOAL_BREAKDOWN_SYSTEM_PROMPT=

ACTION_PLAN_ENABLED=true
# ACTION_PLAN_CONTEXT_MESSAGE_WINDOW=8
# ACTION_PLAN_SYSTEM_PROMPT=

# ── UKL (user knowledge layer) ───────────────────────────────────────────────
# When true: profile dual-write + chat / breakdown / action_plan context packaging.
# See docs/rag-external-memory/ for design details.
UKL_ENABLED=false

# Chat context
# CHAT_WORK_MEMORY_MAX_MESSAGES=12
# CHAT_SUMMARY_USE_THRESHOLD=16
# CHAT_SESSION_SUMMARY_ENABLED=true
# CHAT_SESSION_SUMMARY_SYSTEM_PROMPT=

# Breakdown & execution
# BREAKDOWN_SUMMARY_ENABLED=true
# BREAKDOWN_SUMMARY_SYSTEM_PROMPT=
# ACTION_PLAN_COVERAGE_VALIDATION_ENABLED=true
# EXECUTION_SLICE_ENABLED=true
# ACTION_PLAN_COMPLETION_ASYNC=true

# Growth feedback
# GROWTH_JOURNAL_ENABLED=true
# GROWTH_JOURNAL_SYSTEM_PROMPT=
# FEEDBACK_SUMMARY_SYSTEM_PROMPT=
# MILESTONE_UKL_ENABLED=true
# INSTANT_FEEDBACK_ENABLED=true
# INSTANT_FEEDBACK_SYSTEM_PROMPT=
# GROWTH_PATTERN_ENABLED=true
# GROWTH_PATTERN_CHECKIN_THRESHOLD=5
# GROWTH_PATTERN_MIN_DAYS=7
# GROWTH_PATTERN_SYSTEM_PROMPT=

# Cross-session memory
# EPISODIC_NARRATIVE_ENABLED=true
# EPISODIC_NARRATIVE_SYSTEM_PROMPT=
# GOAL_INTENT_ENABLED=true
# GOAL_INTENT_SYSTEM_PROMPT=

# Memory facts (requires provider support for OpenAI-compatible /embeddings)
# MEMORY_FACT_ENABLED=true
# MEMORY_FACT_EXTRACTION_ENABLED=true
# MEMORY_FACT_EMBEDDING_ENABLED=true
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSIONS=1536
# MEMORY_FACT_TOP_K=5
# MEMORY_FACT_MIN_SCORE=0.72
# MEMORY_FACT_MAX_PER_TURN=3
# MEMORY_FACT_MIN_SALIENCE=0.4
# MEMORY_FACT_EXTRACTION_SYSTEM_PROMPT=

# Optional Qdrant vector index. MySQL remains the source of truth and the
# existing JSON cosine search remains available as a fallback.
# VECTOR_STORE_ENABLED=false
# VECTOR_STORE_BACKEND=qdrant
# VECTOR_STORE_URL=http://localhost:6333
# VECTOR_STORE_API_KEY=
# VECTOR_STORE_COLLECTION=memory_facts
# VECTOR_STORE_TIMEOUT_SECONDS=3
# VECTOR_STORE_STRICT=false

# ── Security ─────────────────────────────────────────────────────────────────
# Used for JWT signing
AUTH_SECRET_KEY="change-me-in-production-with-a-long-secret-key"
AUTH_ALGORITHM="HS256"
AUTH_ACCESS_TOKEN_EXPIRES_MINUTES=120

# Used to encrypt sensitive values in system_config (admin panel); change in production
# APP_SECRET_KEY="ai-mentor-default-secret-change-in-production"

# ── Optional startup admin bootstrap ─────────────────────────────────────────
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
BOOTSTRAP_ADMIN_FULL_NAME="System Administrator"
